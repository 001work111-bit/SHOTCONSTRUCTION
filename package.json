{
  "name": "shot-composer",
  "private": true,
  "version": "1.0.0",
  "description": "Local visual builder & randomizer of block imagery for a one-page site (browser-first, Electron-ready)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron electron/main.cjs",
    "electron:dev": "cross-env SHOT_COMPOSER_DEV=1 electron electron/main.cjs",
    "electron:build": "npm run build && electron electron/main.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "electron": "^33.0.0",
    "sharp": "^0.33.5"
  }
}
